# Settings of one environment, for deploy/deploy.sh. Copy this file to deploy/productie.env
# (not in git: it holds the secret) and fill it in.

# the domain; every part gets a subdomain, see the urls below
DOMEIN=minipol.nl

# the VPS: an ssh user with sudo (or root), and where the code goes
SERVER=deploy@vps.minipol.nl
DOEL=/var/www/minipol

# for the certificates of Let's Encrypt (certbot)
EMAIL=beheer@minipol.nl

# The urls of the parts; these are the defaults, uncomment one to change it.
#APP_URL=https://www.$DOMEIN
#ADMIN_URL=https://admin.$DOMEIN
#API_URL=https://api.$DOMEIN
#CDN_URL=https://cdn.$DOMEIN
#MATH_URL=https://math.$DOMEIN
