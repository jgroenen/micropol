{
  "openapi": "3.1.0",
  "info": {
    "title": "MiniPol API",
    "version": "1.0.0",
    "description": "De API van MiniPol: gesprekken, stellingen, antwoorden, moderatie en de standaardexport voor de math server.\n\nAlle requests en responses zijn JSON. Fouten komen terug als `{ \"error\": \"...\" }` met een passende statuscode.\n\nEndpoints met een slotje zijn alleen voor ingelogde beheerders, met een access token van de auth service (`Authorization: Bearer <token>`). De API controleert het token daar via introspection. Een token voor hier uitproberen haal je via de admin (zie `minipol_admin_tokens` in localStorage) of via de flow van de auth service, en vul je in bij **Authorize**."
  },
  "servers": [
    {
      "url": "http://localhost:8001",
      "description": "Lokaal; op /docs wordt dit de server zelf"
    }
  ],
  "security": [
    {}
  ],
  "tags": [
    {
      "name": "Gesprekken",
      "description": "Een gesprek met zijn stellingen; aanmaken en aanpassen alleen voor beheerders"
    },
    {
      "name": "Stellingen",
      "description": "Stellingen die deelnemers toevoegen"
    },
    {
      "name": "Antwoorden",
      "description": "Eens, neutraal of oneens op een stelling"
    },
    {
      "name": "Moderatie",
      "description": "Alleen voor beheerders"
    },
    {
      "name": "Export",
      "description": "Voor de math server en andere tools"
    },
    {
      "name": "Docs",
      "description": "Deze documentatie"
    }
  ],
  "paths": {
    "/gesprekken": {
      "get": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Alle gesprekken",
        "operationId": "getGesprekken",
        "responses": {
          "200": {
            "description": "De gesprekken, op volgorde van aanmaken",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "gesprekken"
                  ],
                  "properties": {
                    "gesprekken": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Gesprek"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Gesprek aanmaken",
        "operationId": "postGesprek",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Gesprek"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Het nieuwe gesprek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gesprek"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          }
        }
      }
    },
    "/gesprekken/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Eén gesprek met zijn zichtbare stellingen",
        "description": "De stellingen komen in willekeurige volgorde; alleen de zichtbare, zie Moderatie.",
        "operationId": "getGesprek",
        "responses": {
          "200": {
            "description": "Het gesprek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gesprek"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "put": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Gesprek aanpassen",
        "description": "Zonder `moderatie` blijft die gelijk.",
        "operationId": "putGesprek",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Gesprek"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Het aangepaste gesprek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gesprek"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/stellingen": {
      "get": {
        "tags": [
          "Stellingen"
        ],
        "summary": "De stellingen die één deelnemer heeft toegevoegd",
        "description": "Met hun moderatiestatus en hoe ze beantwoord zijn.",
        "operationId": "getMijnStellingen",
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          },
          {
            "name": "deelnemer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Het id van de deelnemer"
          }
        ],
        "responses": {
          "200": {
            "description": "De stellingen, op volgorde van toevoegen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stellingen"
                  ],
                  "properties": {
                    "stellingen": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Stelling"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "post": {
        "tags": [
          "Stellingen"
        ],
        "summary": "Stelling toevoegen",
        "description": "Witruimte wordt één spatie. Of de stelling direct zichtbaar is, hangt af van de moderatie van het gesprek.",
        "operationId": "postStelling",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Een stelling, met gesprek_id en deelnemer_id",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Stelling"
                  },
                  {
                    "required": [
                      "gesprek_id",
                      "deelnemer_id",
                      "tekst"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "De nieuwe stelling",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stelling"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/antwoorden": {
      "get": {
        "tags": [
          "Antwoorden"
        ],
        "summary": "De antwoorden van één deelnemer, of van iedereen als matrix",
        "description": "Met `deelnemer_id`: de antwoorden van die deelnemer. Zonder: de matrix, per deelnemer anoniem, zoals in de export.",
        "operationId": "getAntwoorden",
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          },
          {
            "name": "deelnemer_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "De antwoorden",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "title": "Van één deelnemer",
                      "type": "object",
                      "required": [
                        "antwoorden"
                      ],
                      "properties": {
                        "antwoorden": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Antwoord"
                          }
                        }
                      }
                    },
                    {
                      "title": "Matrix",
                      "type": "object",
                      "required": [
                        "gesprek_id",
                        "deelnemers"
                      ],
                      "properties": {
                        "gesprek_id": {
                          "type": "string"
                        },
                        "deelnemers": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Deelnemer"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "post": {
        "tags": [
          "Antwoorden"
        ],
        "summary": "Antwoord geven",
        "description": "Alleen op zichtbare stellingen. Opnieuw antwoorden mag; het laatste antwoord telt.",
        "operationId": "postAntwoord",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Een antwoord, met alle velden",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Antwoord"
                  },
                  {
                    "required": [
                      "gesprek_id",
                      "deelnemer_id",
                      "stelling_id",
                      "waarde"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Het opgeslagen antwoord",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Antwoord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/beoordelingen": {
      "get": {
        "tags": [
          "Moderatie"
        ],
        "summary": "Alle stellingen van een gesprek met hun moderatiestatus",
        "description": "Ook de onzichtbare, op volgorde van toevoegen, zonder wie ze toevoegde.",
        "operationId": "getBeoordelingen",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          }
        ],
        "responses": {
          "200": {
            "description": "De stellingen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stellingen"
                  ],
                  "properties": {
                    "stellingen": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Stelling"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "post": {
        "tags": [
          "Moderatie"
        ],
        "summary": "Stelling goedkeuren of afkeuren",
        "description": "Bij `afgekeurd` is een reden verplicht; die ziet de indiener. Een beoordeling is altijd te herzien: de laatste telt.",
        "operationId": "postBeoordeling",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Een beoordeling, met gesprek_id",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Beoordeling"
                  },
                  {
                    "required": [
                      "gesprek_id",
                      "stelling_id",
                      "beoordeling"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "De stelling met zijn nieuwe status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stelling"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/export": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "De standaardexport van een gesprek",
        "description": "Anoniem: alleen zichtbare stellingen, deelnemers genummerd zoals in de matrix, per deelnemer het laatste antwoord.",
        "operationId": "getExport",
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          }
        ],
        "responses": {
          "200": {
            "description": "De export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "Deze documentatie (Swagger UI)",
        "operationId": "getDocs",
        "responses": {
          "200": {
            "description": "HTML-pagina",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/docs/openapi.json": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "De OpenAPI-spec van deze API",
        "operationId": "getOpenapi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Een access token van de auth service (OAuth 2), zie de docs van de auth service"
      }
    },
    "parameters": {
      "GesprekId": {
        "name": "gesprek_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Fout": {
        "description": "Ongeldig verzoek",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Fout"
            }
          }
        }
      },
      "NietIngelogd": {
        "description": "Geen of geen geldig token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Fout"
            }
          }
        }
      },
      "NietGevonden": {
        "description": "Gesprek of stelling niet gevonden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Fout"
            }
          }
        }
      }
    },
    "schemas": {
      "Fout": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Waarde": {
        "type": "string",
        "enum": [
          "eens",
          "neutraal",
          "oneens"
        ]
      },
      "Moderatie": {
        "type": "string",
        "enum": [
          "achteraf",
          "vooraf"
        ],
        "description": "`achteraf`: stellingen zijn zichtbaar tenzij afgekeurd. `vooraf`: alleen als goedgekeurd."
      },
      "Telling": {
        "type": "object",
        "description": "Hoeveel deelnemers elk antwoord gaven",
        "required": [
          "eens",
          "neutraal",
          "oneens"
        ],
        "properties": {
          "eens": {
            "type": "integer",
            "minimum": 0
          },
          "neutraal": {
            "type": "integer",
            "minimum": 0
          },
          "oneens": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Gesprek": {
        "description": "Een gesprek. `stellingen` staat er alleen in bij `GET /gesprekken/{id}`.",
        "type": "object",
        "required": [
          "titel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "titel": {
            "type": "string",
            "maxLength": 200
          },
          "omschrijving": {
            "type": "string",
            "maxLength": 1000,
            "description": "Optioneel; standaard leeg"
          },
          "moderatie": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Moderatie"
              }
            ],
            "description": "Optioneel; bij aanmaken standaard `achteraf`, bij aanpassen standaard ongewijzigd"
          },
          "stellingen": {
            "type": "array",
            "readOnly": true,
            "items": {
              "$ref": "#/components/schemas/Stelling"
            },
            "description": "De zichtbare stellingen, in willekeurige volgorde (alleen `id` en `tekst`)"
          }
        }
      },
      "Stelling": {
        "description": "Een stelling. Welke velden erin staan, hangt af van waar hij vandaan komt:\n\n- in een gesprek (`GET /gesprekken/{id}`, de export): alleen `id` en `tekst`\n- toegevoegd (`POST /stellingen`): alles behalve `antwoorden`\n- eigen stellingen (`GET /stellingen`): alles\n- beheer (`/beoordelingen`): alles behalve `deelnemer_id`\n\n`deelnemer_id` staat alleen in antwoorden aan de indiener zelf.",
        "type": "object",
        "required": [
          "tekst"
        ],
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "gesprek_id": {
            "type": "string"
          },
          "deelnemer_id": {
            "type": "string",
            "description": "De deelnemer die hem toevoegde"
          },
          "tekst": {
            "type": "string",
            "maxLength": 500,
            "description": "Witruimte wordt één spatie"
          },
          "beoordeling": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "goedgekeurd",
              "afgekeurd",
              null
            ],
            "readOnly": true,
            "description": "null: nog niet beoordeeld"
          },
          "reden": {
            "type": "string",
            "readOnly": true,
            "description": "Bij afgekeurd; de indiener ziet hem"
          },
          "zichtbaar": {
            "type": "boolean",
            "readOnly": true,
            "description": "Of deelnemers hem zien; volgt uit de moderatie van het gesprek en de beoordeling"
          },
          "antwoorden": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Telling"
              }
            ],
            "readOnly": true,
            "description": "Hoe hij beantwoord is"
          }
        }
      },
      "Antwoord": {
        "description": "Een antwoord van een deelnemer op een stelling; opnieuw antwoorden mag, het laatste telt.",
        "type": "object",
        "required": [
          "stelling_id",
          "waarde"
        ],
        "properties": {
          "gesprek_id": {
            "type": "string"
          },
          "deelnemer_id": {
            "type": "string"
          },
          "stelling_id": {
            "type": "string"
          },
          "waarde": {
            "$ref": "#/components/schemas/Waarde"
          }
        }
      },
      "Beoordeling": {
        "description": "Een beoordeling van een stelling door een beheerder; de laatste telt. Bij `afgekeurd` is een reden verplicht.",
        "type": "object",
        "required": [
          "stelling_id",
          "beoordeling"
        ],
        "properties": {
          "gesprek_id": {
            "type": "string"
          },
          "stelling_id": {
            "type": "string"
          },
          "beoordeling": {
            "type": "string",
            "enum": [
              "goedgekeurd",
              "afgekeurd"
            ]
          },
          "reden": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "Deelnemer": {
        "description": "Een deelnemer, anoniem: genummerd op volgorde van het eerste antwoord, met per stelling het laatste antwoord. Dezelfde nummers in de matrix, de export en de analyse.",
        "type": "object",
        "required": [
          "nummer",
          "antwoorden"
        ],
        "properties": {
          "nummer": {
            "type": "integer",
            "minimum": 1
          },
          "antwoorden": {
            "type": "object",
            "description": "stelling_id => waarde",
            "additionalProperties": {
              "$ref": "#/components/schemas/Waarde"
            }
          }
        }
      },
      "Export": {
        "type": "object",
        "required": [
          "formaat",
          "versie",
          "gegenereerd",
          "gesprek",
          "stellingen",
          "deelnemers"
        ],
        "properties": {
          "formaat": {
            "const": "minipol-export"
          },
          "versie": {
            "const": 1
          },
          "gegenereerd": {
            "type": "string",
            "format": "date-time"
          },
          "gesprek": {
            "type": "object",
            "required": [
              "id",
              "titel"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "titel": {
                "type": "string"
              }
            }
          },
          "stellingen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stelling"
            },
            "description": "De zichtbare stellingen (alleen `id` en `tekst`)"
          },
          "deelnemers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Deelnemer"
            }
          }
        }
      }
    }
  }
}
