{
  "openapi": "3.1.0",
  "info": {
    "title": "MiniPol API",
    "version": "1.0.0",
    "description": "De API van MiniPol: gesprekken, stellingen, antwoorden, moderatie, het logboek (events) en de standaardexport voor de math server.\n\nAlle requests en responses zijn JSON. Fouten komen terug als `{ \"error\": \"...\" }` met een passende statuscode.\n\nEndpoints met een slotje zijn alleen voor ingelogde beheerders: log in met `POST /sessie` en vul het token in bij **Authorize**. Een token blijft geldig zolang het gebruikt wordt: het verloopt na een uur zonder gebruik, en na 12 uur altijd."
  },
  "servers": [
    {
      "url": "http://localhost:8001",
      "description": "Lokaal; op /docs wordt dit de server zelf"
    }
  ],
  "security": [
    {}
  ],
  "tags": [
    {
      "name": "Gesprekken",
      "description": "Een gesprek met zijn stellingen; aanmaken en aanpassen alleen voor beheerders"
    },
    {
      "name": "Stellingen",
      "description": "Stellingen die deelnemers toevoegen"
    },
    {
      "name": "Antwoorden",
      "description": "Eens, neutraal of oneens op een stelling"
    },
    {
      "name": "Moderatie",
      "description": "Alleen voor beheerders"
    },
    {
      "name": "Events",
      "description": "Wat er in een gesprek gebeurde; alleen voor beheerders"
    },
    {
      "name": "Export",
      "description": "Voor de math server en andere tools"
    },
    {
      "name": "Docs",
      "description": "Deze documentatie"
    },
    {
      "name": "Sessie",
      "description": "Inloggen in de beheeromgeving"
    }
  ],
  "paths": {
    "/gesprekken": {
      "get": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Alle gesprekken",
        "operationId": "getGesprekken",
        "responses": {
          "200": {
            "description": "De gesprekken, op volgorde van aanmaken",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "gesprekken"
                  ],
                  "properties": {
                    "gesprekken": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Gesprek"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Gesprek aanmaken",
        "operationId": "postGesprek",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Gesprek"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Het nieuwe gesprek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gesprek"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          }
        }
      }
    },
    "/gesprekken/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Eén gesprek met zijn zichtbare stellingen",
        "description": "De stellingen komen in willekeurige volgorde; alleen de zichtbare, zie Moderatie.",
        "operationId": "getGesprek",
        "responses": {
          "200": {
            "description": "Het gesprek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gesprek"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "put": {
        "tags": [
          "Gesprekken"
        ],
        "summary": "Gesprek aanpassen",
        "description": "Zonder `moderatie` blijft die gelijk.",
        "operationId": "putGesprek",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Gesprek"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Het aangepaste gesprek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Gesprek"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/stellingen": {
      "get": {
        "tags": [
          "Stellingen"
        ],
        "summary": "De stellingen die één deelnemer heeft toegevoegd",
        "description": "Met hun moderatiestatus en hoe ze beantwoord zijn.",
        "operationId": "getMijnStellingen",
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          },
          {
            "name": "deelnemer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$"
            },
            "description": "Het id van de deelnemer"
          }
        ],
        "responses": {
          "200": {
            "description": "De stellingen, op volgorde van toevoegen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stellingen"
                  ],
                  "properties": {
                    "stellingen": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Stelling"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "post": {
        "tags": [
          "Stellingen"
        ],
        "summary": "Stelling toevoegen",
        "description": "Witruimte wordt één spatie. Of de stelling direct zichtbaar is, hangt af van de moderatie van het gesprek.",
        "operationId": "postStelling",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Een stelling, met gesprek_id en deelnemer_id",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Stelling"
                  },
                  {
                    "required": [
                      "gesprek_id",
                      "deelnemer_id",
                      "tekst"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "De nieuwe stelling",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stelling"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/antwoorden": {
      "get": {
        "tags": [
          "Antwoorden"
        ],
        "summary": "De antwoorden van één deelnemer, of van iedereen als matrix",
        "description": "Met `deelnemer_id`: de antwoorden van die deelnemer. Zonder: de matrix, per deelnemer anoniem, zoals in de export.",
        "operationId": "getAntwoorden",
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          },
          {
            "name": "deelnemer_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "De antwoorden",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "title": "Van één deelnemer",
                      "type": "object",
                      "required": [
                        "antwoorden"
                      ],
                      "properties": {
                        "antwoorden": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Antwoord"
                          }
                        }
                      }
                    },
                    {
                      "title": "Matrix",
                      "type": "object",
                      "required": [
                        "gesprek_id",
                        "deelnemers"
                      ],
                      "properties": {
                        "gesprek_id": {
                          "type": "string"
                        },
                        "deelnemers": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Deelnemer"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "post": {
        "tags": [
          "Antwoorden"
        ],
        "summary": "Antwoord geven",
        "description": "Alleen op zichtbare stellingen. Opnieuw antwoorden mag; het laatste antwoord telt.",
        "operationId": "postAntwoord",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Een antwoord, met alle velden",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Antwoord"
                  },
                  {
                    "required": [
                      "gesprek_id",
                      "deelnemer_id",
                      "stelling_id",
                      "waarde"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Het opgeslagen antwoord",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Antwoord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "description": "Gesprek niet gevonden, of de stelling hoort er niet bij of is niet zichtbaar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          }
        }
      }
    },
    "/beoordelingen": {
      "get": {
        "tags": [
          "Moderatie"
        ],
        "summary": "Alle stellingen van een gesprek met hun moderatiestatus",
        "description": "Ook de onzichtbare, op volgorde van toevoegen, zonder wie ze toevoegde.",
        "operationId": "getBeoordelingen",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          }
        ],
        "responses": {
          "200": {
            "description": "De stellingen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stellingen"
                  ],
                  "properties": {
                    "stellingen": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Stelling"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      },
      "post": {
        "tags": [
          "Moderatie"
        ],
        "summary": "Stelling goedkeuren of afkeuren",
        "description": "Bij `afgekeurd` is een reden verplicht; die ziet de indiener. Een beoordeling is altijd te herzien: de laatste telt.",
        "operationId": "postBeoordeling",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "description": "Een beoordeling, met gesprek_id",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Beoordeling"
                  },
                  {
                    "required": [
                      "gesprek_id",
                      "stelling_id",
                      "beoordeling"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "De stelling met zijn nieuwe status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stelling"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Wat er in een gesprek gebeurde, nieuwste eerst",
        "description": "De events van het gesprek: aangemaakt en aangepast, stellingen toegevoegd, goedgekeurd en afgekeurd, en antwoorden. Deelnemers staan erin met hun nummer uit de matrix, nooit met hun id. Events over een stelling hebben de `tekst` ervan. Oudere events haal je op met `voor`: het id van het oudste event dat je al hebt.",
        "operationId": "getEvents",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          },
          {
            "name": "voor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alleen events van vóór het event met dit id"
          },
          {
            "name": "limiet",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "description": "Hoeveel events hooguit"
          }
        ],
        "responses": {
          "200": {
            "description": "De events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "events",
                    "meer"
                  ],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "meer": {
                      "type": "boolean",
                      "description": "Of er oudere events zijn"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "$ref": "#/components/responses/NietIngelogd"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/export": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "De standaardexport van een gesprek",
        "description": "Anoniem: alleen zichtbare stellingen, deelnemers genummerd zoals in de matrix, per deelnemer het laatste antwoord.",
        "operationId": "getExport",
        "parameters": [
          {
            "$ref": "#/components/parameters/GesprekId"
          }
        ],
        "responses": {
          "200": {
            "description": "De export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Export"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "404": {
            "$ref": "#/components/responses/NietGevonden"
          }
        }
      }
    },
    "/sessie": {
      "get": {
        "tags": [
          "Sessie"
        ],
        "summary": "De ingelogde beheerder",
        "description": "Zonder geldig token: `{ \"beheerder\": null }`. Een geldig token wordt verlengd.",
        "operationId": "getSessie",
        "security": [
          {
            "bearer": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "De beheerder van het token, of null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "beheerder"
                  ],
                  "properties": {
                    "beheerder": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Beheerder"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Sessie"
        ],
        "summary": "Inloggen",
        "operationId": "postSessie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "gebruikersnaam",
                  "wachtwoord"
                ],
                "properties": {
                  "gebruikersnaam": {
                    "type": "string"
                  },
                  "wachtwoord": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingelogd",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "beheerder",
                    "token",
                    "verloopt"
                  ],
                  "properties": {
                    "beheerder": {
                      "$ref": "#/components/schemas/Beheerder"
                    },
                    "token": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "verloopt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Als het token niet gebruikt wordt"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Fout"
          },
          "401": {
            "description": "Onjuiste gebruikersnaam of wachtwoord",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Fout"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Sessie"
        ],
        "summary": "Uitloggen",
        "description": "Het token werkt daarna niet meer.",
        "operationId": "deleteSessie",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Uitgelogd"
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "Deze documentatie (Swagger UI)",
        "operationId": "getDocs",
        "responses": {
          "200": {
            "description": "HTML-pagina",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/docs/openapi.json": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "De OpenAPI-spec van deze API",
        "operationId": "getOpenapi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/docs/schema.json": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "De typen van deze API als JSON Schema",
        "description": "Dezelfde typen als in deze spec, in een los JSON Schema-bestand (2020-12), om zelf te gebruiken. `$id` is de url van het bestand.",
        "operationId": "getSchema",
        "responses": {
          "200": {
            "description": "JSON Schema",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Het token uit `POST /sessie`"
      }
    },
    "parameters": {
      "GesprekId": {
        "name": "gesprek_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Fout": {
        "description": "Ongeldig verzoek",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Fout"
            }
          }
        }
      },
      "NietIngelogd": {
        "description": "Geen of geen geldig token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Fout"
            }
          }
        }
      },
      "NietGevonden": {
        "description": "Gesprek of stelling niet gevonden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Fout"
            }
          }
        }
      }
    },
    "schemas": {
      "Fout": {
        "$ref": "schema.json#/$defs/Fout"
      },
      "Waarde": {
        "$ref": "schema.json#/$defs/Waarde"
      },
      "Moderatie": {
        "$ref": "schema.json#/$defs/Moderatie"
      },
      "Telling": {
        "$ref": "schema.json#/$defs/Telling"
      },
      "Gesprek": {
        "$ref": "schema.json#/$defs/Gesprek"
      },
      "Stelling": {
        "$ref": "schema.json#/$defs/Stelling"
      },
      "Antwoord": {
        "$ref": "schema.json#/$defs/Antwoord"
      },
      "Beoordeling": {
        "$ref": "schema.json#/$defs/Beoordeling"
      },
      "EventType": {
        "$ref": "schema.json#/$defs/EventType"
      },
      "Event": {
        "$ref": "schema.json#/$defs/Event"
      },
      "Deelnemer": {
        "$ref": "schema.json#/$defs/Deelnemer"
      },
      "Export": {
        "$ref": "schema.json#/$defs/Export"
      },
      "Beheerder": {
        "$ref": "schema.json#/$defs/Beheerder"
      }
    }
  }
}
