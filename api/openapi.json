          },
          "gegenereerd": {
            "type": "string",
            "format": "date-time"
          },
          "gesprek": {
            "type": "object",
            "required": [
              "id",
              "titel"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "titel": {
                "type": "string"
              }
            }
          },
          "stellingen": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stelling"
            }
          },
          "deelnemers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nummer",
                "antwoorden"
              ],
              "properties": {
                "nummer": {
                  "type": "integer",
                  "minimum": 1
                },
                "antwoorden": {
                  "$ref": "#/components/schemas/AntwoordenPerStelling"
                }
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email"
        ],
        "properties": {
